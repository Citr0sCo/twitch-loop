ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:80
APP__PUBLICORIGIN=https://twitch-loop.example.com
APP__DATADIRECTORY=/data
APP_TIMEZONE=Europe/London
TWITCH_CLIENT_ID=replace-me
TWITCH_CLIENT_SECRET=replace-me
TWITCH_REDIRECT_URI=https://twitch-loop.example.com/api/auth/twitch/callback
# Twitch login allowed to connect, for example: citr0s.
APP_ALLOWED_OWNER_TWITCH_LOGIN=
