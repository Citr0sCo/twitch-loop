{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {
    "twitch-loop-web": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "tl",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": { "base": "dist/twitch-loop-web" },
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": ["src/polyfills.ts"],
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": ["src/favicon.svg", "src/assets", "src/manifest.webmanifest"],
            "styles": ["src/styles.scss"]
          },
          "configurations": {
            "production": { "budgets": [{ "type": "initial", "maximumWarning": "700kb", "maximumError": "1.5mb" }], "outputHashing": "all" },
            "development": { "optimization": false, "sourceMap": true, "extractLicenses": false }
          },
          "defaultConfiguration": "production"
        },
        "serve": { "builder": "@angular/build:dev-server", "configurations": { "production": { "buildTarget": "twitch-loop-web:build:production" }, "development": { "buildTarget": "twitch-loop-web:build:development" } }, "defaultConfiguration": "development" },
        "test": { "builder": "@angular/build:unit-test", "options": { "tsConfig": "tsconfig.spec.json", "runner": "karma", "runnerConfig": "karma.conf.js", "buildTarget": "twitch-loop-web:build:development" } }
      }
    }
  },
  "cli": { "analytics": false }
}
